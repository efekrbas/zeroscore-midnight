# Midnight Network RPC Endpoints
# Example values for Testnet-02

# The URL of the Midnight Proof Server for computing ZK Proofs locally
VITE_MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300

# The URL of the Midnight Node / Indexer to query public state
VITE_MIDNIGHT_INDEXER_URL=https://indexer.testnet-02.midnight.network

# Network ID for Midnight (e.g. testnet-02, undeployed, preprod)
VITE_NETWORK_ID=testnet-02

# Note: The prompt mentioned NEXT_PUBLIC_ variables, but since this project
# is built using Vite (Lovable default), we use the VITE_ prefix.
NEXT_PUBLIC_MIDNIGHT_RPC_URL=https://rpc.testnet-02.midnight.network
NEXT_PUBLIC_NETWORK_ID=testnet-02
